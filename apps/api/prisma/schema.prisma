datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  defaultDeviceId String?
  createdAt       DateTime  @default(now())

  devices         Device[]
  apiKeys         ApiKey[]
  messages        Message[]
  otpRequests     OtpRequest[]
}

model Device {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  deviceToken    String    @unique
  // Stable per-phone identifier generated by the Android app. Lets the server
  // recognise the same physical phone when it is re-paired, so the previous
  // owner's access can be revoked instead of leaving a live orphan.
  deviceIdentifier String?
  status         String    @default("offline") // online | offline
  lastSeenAt     DateTime  @default(now())
  gatewayEnabled Boolean   @default(true)
  androidVersion String?
  serviceRunning Boolean?
  permissions    Json?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  simCards       SimCard[]
  messages       Message[]

  @@index([deviceIdentifier])
}

model SimCard {
  id             String    @id @default(uuid())
  deviceId       String
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  subscriptionId Int
  slotIndex      Int
  carrierName    String
  phoneNumber    String?
  enabled        Boolean   @default(true)
  isDefault      Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@unique([deviceId, subscriptionId])
}

model ApiKey {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  keyHash        String    @unique
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  messages       Message[]
}

model Message {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId       String?
  apiKey         ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  deviceId       String?
  device         Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  simId          String?
  sim            SimCard?  @relation(fields: [simId], references: [id], onDelete: SetNull)

  to             String
  body           String
  status         String    @default("queued") // queued | sending | sent | failed
  errorMessage   String?
  failureReason  String?   // NO_SIGNAL | SEND_FAILED | NO_SIM | PERMISSION_DENIED | INVALID_NUMBER | UNKNOWN
  correlationId  String    @default(uuid())

  createdAt      DateTime  @default(now())
  claimedAt      DateTime?
  sendingAt      DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
}

/// A one-time verification code sent to a phone number.
model OtpRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  to           String
  codeHash     String    // sha256 of the code — the code itself is never stored
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int       @default(0)
  messageId    String?
  createdAt    DateTime  @default(now())

  @@index([to])
  @@index([userId])
}

